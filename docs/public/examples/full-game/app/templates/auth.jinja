{% extends 'base.jinja' %}{% block title %}{{ 'Create account' if registering else 'Sign in' }} · Bot Lab{% endblock %}{% block content %}
<div class="form-layout"><div><p class="eyebrow">{{ 'YOUR FRESH START' if registering else 'YOUR NEXT CHAPTER' }}</p><h1>{{ 'New player.' if registering else 'Welcome back.' }}</h1><p class="lede">{{ 'Make a throwaway account. Play a round. See what your choices say.' if registering else 'Your saved results are right where you left them.' }}</p><p class="small">Local classroom reference. Use a made-up username and a password you do not use elsewhere.</p></div><section class="card form-card"><h2>{{ 'Create your account' if registering else 'Sign in to Bot Lab' }}</h2><form method="post"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><label for="username">Username</label><input id="username" name="username" autocomplete="username" minlength="3" maxlength="24" pattern="[a-zA-Z0-9_]{3,24}" required value="{{ request.form.get('username','') }}"><p class="hint">3–24 letters, numbers or underscores; case does not matter.</p>{% if registering %}<label for="display_name">Display name</label><input id="display_name" name="display_name" autocomplete="nickname" maxlength="40" required value="{{ request.form.get('display_name','') }}">{% endif %}<label for="password">Password</label><input id="password" name="password" type="password" autocomplete="{{ 'new-password' if registering else 'current-password' }}" {% if registering %}minlength="12"{% endif %} maxlength="128" required>{% if registering %}<p class="hint">12–128 characters. A made-up passphrase works.</p>{% endif %}<button class="button wide">{{ 'Create account & continue' if registering else 'Sign in' }}</button></form><p class="small">{% if registering %}Already have an account? <a href="{{ url_for('auth.login') }}">Sign in</a>.{% else %}First visit? <a href="{{ url_for('auth.register') }}">Create an account</a>.{% endif %}</p></section></div>
{% endblock %}
