{% extends 'base.jinja' %}{% block title %}Round {{ game.id }} · Bot Lab{% endblock %}{% block content %}
<div class="section-heading"><div><p class="eyebrow">ROUND #{{ game.id }} / {{ bot_name|upper }}</p><h1>{{ 'The result is in.' if game.outcome else 'Trust your next move.' }}</h1></div><a href="{{ url_for('game.dashboard') }}">← Your dashboard</a></div>
{% if game.outcome %}<section class="arena result-screen" aria-labelledby="result"><p class="eyebrow">ONE ROUND. SAVED ONCE.</p><h2 id="result">{{ {'win':'You win. Nice read.','loss':'Bot wins. Try a new angle.','tie':'A tie. Same wavelength.'}[game.outcome] }}</h2><div class="versus"><div><span>YOU</span><strong>{{ game.player_move|capitalize }}</strong></div><span class="vs">vs</span><div><span>{{ bot_name|upper }}</span><strong>{{ game.bot_move|capitalize }}</strong></div></div><p class="small">This result belongs to your account. Refreshing this page or repeating the request will not add another score.</p><form action="{{ url_for('game.new_round') }}" method="post"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="bot" value="{{ game.bot }}"><button class="button">Play again <span aria-hidden="true">↗</span></button></form></section>
{% else %}<section class="arena" aria-labelledby="move-title"><p class="eyebrow">ROCK BEATS SCISSORS · SCISSORS BEATS PAPER · PAPER BEATS ROCK</p><h2 id="move-title">What will you throw?</h2><p>{{ 'Clockwork cycles through rock, paper and scissors using your completed-round count.' if game.bot == 'clockwork' else 'Habit Reader opens with rock, then counters your most frequent earlier move. It cannot see this choice.' }}</p><form action="{{ url_for('game.move',round_id=game.id) }}" method="post" class="moves"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button name="move" value="rock"><span aria-hidden="true">●</span>Rock</button><button name="move" value="paper"><span aria-hidden="true">▤</span>Paper</button><button name="move" value="scissors"><span aria-hidden="true">✂</span>Scissors</button></form><p class="small">The backend chooses the bot move from earlier results, checks the outcome, then saves it.</p></section>{% endif %}
{% endblock %}
