<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Bot Lab · Your next move{% endblock %}</title><link rel="stylesheet" href="{{ url_for('static',filename='style.css') }}"></head>
<body><a class="skip" href="#main">Skip to content</a><header class="top"><a class="brand" href="{{ url_for('game.home') }}"><span class="brand-mark">B↗</span> BOT LAB</a><nav aria-label="Main navigation">{% if current_user.is_authenticated %}<a href="{{ url_for('game.dashboard') }}">Dashboard</a><a href="{{ url_for('auth.account') }}">Account</a><form action="{{ url_for('auth.logout') }}" method="post"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="text-button">Sign out</button></form>{% else %}<a href="{{ url_for('auth.login') }}">Sign in</a><a class="button compact" href="{{ url_for('auth.register') }}">Create account</a>{% endif %}</nav></header>
<main id="main" tabindex="-1">{% with messages=get_flashed_messages(with_categories=true) %}{% for category,message in messages %}<div class="notice {{ category }}" role="status">{{ message }}</div>{% endfor %}{% endwith %}{% block content %}{% endblock %}</main>
<footer><span>ONE MOVE. A LITTLE MORE SELF-KNOWLEDGE.</span><p>IS218 teaching example · local Flask + SQLite app · use made-up accounts</p></footer></body></html>
