{% extends 'base.jinja' %}{% block title %}Your dashboard · Bot Lab{% endblock %}{% block content %}
<div class="section-heading"><div><p class="eyebrow">YOUR PRIVATE PLAYBOOK</p><h1>Hey, {{ current_user.display_name }}.</h1><p class="lede">{{ 'Your first round is a fresh start.' if not total else 'Every round leaves a little evidence.' }}</p></div><span class="pill">{{ total }} saved {{ 'round' if total == 1 else 'rounds' }}</span></div>
<div class="stats" aria-label="Your saved totals"><div><strong>{{ totals.win }}</strong><span>Wins</span></div><div><strong>{{ totals.loss }}</strong><span>Losses</span></div><div><strong>{{ totals.tie }}</strong><span>Ties</span></div></div>
<section class="card start"><div><p class="eyebrow">PLAY ONE ROUND</p><h2>Choose your challenge.</h2><p>Pick an opponent, then choose a move. The server checks the rules and saves one result.</p></div><form method="post" action="{{ url_for('game.new_round') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><label for="bot">Opponent</label><select name="bot" id="bot"><option value="clockwork">Clockwork · follows a cycle</option><option value="habit-reader">Habit Reader · counters your habits</option></select><button class="button">Start a round <span aria-hidden="true">↗</span></button></form></section>
<section><div class="section-heading"><h2>Recent rounds</h2><span class="small">Newest first · up to 20</span></div>{% if rounds %}<div class="table-wrap"><table><caption class="sr-only">Your saved round history</caption><thead><tr><th>Round</th><th>Opponent</th><th>Your move</th><th>Bot move</th><th>Result</th></tr></thead><tbody>{% for game in rounds %}<tr><td><a href="{{ url_for('game.arena',round_id=game.id) }}">#{{ game.id }}</a></td><td>{{ bot_names[game.bot] }}</td><td>{{ game.player_move|capitalize }}</td><td>{{ game.bot_move|capitalize }}</td><td><span class="result-tag {{ game.outcome }}">{{ game.outcome|capitalize }}</span></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty"><span aria-hidden="true">↗</span><h3>Your story starts with one move.</h3><p>No saved rounds yet. Choose an opponent above and start playing.</p></div>{% endif %}</section>
{% endblock %}
